[MAIN]
# Match .flake8 exclude list; also skip build/ (stale code copies) and htmlcov/.
ignore=.git,__pycache__,venv,.venv,build,htmlcov
# Structural / refactoring checks are tracked separately; keeping them here
# would drown out actionable issues. Line length is deliberately not enforced,
# matching .flake8 (which ignores E501). FIXME/TODO markers are tracked as
# work items, not code issues.
disable=
    fixme,
    # Import resolution depends on the environment, not on the code: pylint
    # runs in environments (e.g. super-linter) where project dependencies are
    # not installed.
    import-error,
    line-too-long,
    duplicate-code,
    # opl.status_data, opl.cluster_read and opl.skelet intentionally import
    # each other; the cycle is safe at runtime because the imports are only
    # used inside functions.
    cyclic-import,
    too-few-public-methods,
    too-many-lines,
    too-many-ancestors,
    too-many-instance-attributes,
    too-many-public-methods,
    too-many-return-statements,
    too-many-branches,
    too-many-arguments,
    too-many-locals,
    too-many-statements,
    too-many-boolean-expressions,
    too-many-positional-arguments,
    too-many-nested-blocks

[REPORTS]
score=y
